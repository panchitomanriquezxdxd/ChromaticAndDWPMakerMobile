<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Idioma (se puede cambiar en cualquier momento) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/languageButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/language" />

        <!-- Carpeta de muestras -->
        <TextView
            android:id="@+id/dirText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_folder"
            android:textColor="@android:color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dirPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_folder" />

        <TextView
            android:id="@+id/dirPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/no_folder_selected"
            android:textColor="#555555" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/folder_hint"
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- Audio con markers (Slicex) -->
        <TextView
            android:id="@+id/slicexTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/slicex_section"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/slicex_hint"
            android:textColor="#777777"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slicexPick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/slicex_pick" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slicexRemove"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/slicex_remove" />
        </LinearLayout>

        <TextView
            android:id="@+id/slicexInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/slicex_none"
            android:textColor="#555555" />

        <com.bichoelproxd.chromaticscalegenerator.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/slicex_wave_desc" />

        <TextView
            android:id="@+id/slicexCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/slicex_example"
            android:textColor="#555555"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/slicexPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/slicexIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/slicex_detect_label"
                android:textColor="@android:color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/slicexSens"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexDetect"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/slicex_detect" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/slicex_equal_label"
                android:textColor="@android:color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/slicexParts"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="16"
                    tools:ignore="HardcodedText,LabelFor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexEqual"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/slicex_equal" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/slicex_shift_label"
                android:textColor="@android:color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexBack"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slicex_before" />

                <EditText
                    android:id="@+id/slicexMs"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="35"
                    tools:ignore="HardcodedText,LabelFor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexFwd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slicex_after" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexClear"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/slicex_clear" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slicexRestore"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/slicex_restore" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nota inicial -->
        <TextView
            android:id="@+id/startNoteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/starting_note"
            android:textColor="@android:color/black" />

        <Spinner
            android:id="@+id/startNoteChoice"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Octava inicial -->
        <TextView
            android:id="@+id/startOctaveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/starting_octave"
            android:textColor="@android:color/black" />

        <Spinner
            android:id="@+id/startOctaveChoice"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Rango -->
        <TextView
            android:id="@+id/rangeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/range"
            android:textColor="@android:color/black" />

        <EditText
            android:id="@+id/rangeInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAutofill="no"
            android:inputType="number"
            android:text="24"
            tools:ignore="HardcodedText,LabelFor" />

        <!-- Separacion entre muestras -->
        <TextView
            android:id="@+id/gapText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sample_gap"
            android:textColor="@android:color/black" />

        <EditText
            android:id="@+id/gapInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:text="0.1"
            tools:ignore="HardcodedText,LabelFor" />

        <CheckBox
            android:id="@+id/pitchedCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/pitched" />

        <CheckBox
            android:id="@+id/samplesCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/dump_samples" />

        <CheckBox
            android:id="@+id/trimCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/auto_trim" />

        <CheckBox
            android:id="@+id/normalizeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/normalize_volume" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chromGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/generate" />

        <!-- Programa de DirectWave (.dwp) -->
        <TextView
            android:id="@+id/dwpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dwp_section"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dwp_hint"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dwpNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dwp_name"
            android:textColor="@android:color/black" />

        <EditText
            android:id="@+id/dwpNameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40"
            android:text="Program"
            tools:ignore="HardcodedText,LabelFor" />

        <TextView
            android:id="@+id/dwpQualityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dwp_quality"
            android:textColor="@android:color/black" />

        <Spinner
            android:id="@+id/dwpQualityChoice"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <CheckBox
            android:id="@+id/dwpLoopCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/dwp_auto_loop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dwpCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dwp_create" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_ready"
            android:textColor="@android:color/black" />
    </LinearLayout>
</ScrollView>
